<Window x:Class="desktopapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktopapp"
        xmlns:vm="clr-namespace:desktopapp.ViewModels"
        mc:Ignorable="d"
        Title="Task Manager - Panel Administratora" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <TabControl Margin="10">

            <TabItem Header="Zarządzanie Zadaniami">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,10">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="Zarządzanie zadaniami" FontSize="20" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <Button Content="Dodaj nowe zadanie" Command="{Binding OpenAddTaskWindowCommand}" Width="130" Margin="0,0,10,0" Click="Button_Click" VerticalAlignment="Center"/>
                                <Button Content="Edytuj wybrane" Command="{Binding EditTaskCommand}" Width="120" Margin="0,0,10,0" Background="#FFA500" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Usuń wybrane" Command="{Binding DeleteTaskCommand}" Background="#FF4444" Foreground="White" Width="100" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Prawa strona (Wyloguj) -->
                            <Button Content="Wyloguj się" Command="{Binding LogoutCommand}" Background="#555555" Foreground="White" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        
                        

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filtruj po użytkowniku:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <TextBox Width="200" Text="{Binding SearchUserText, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Wybierz projekt:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <ComboBox Width="200" ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProjectFilter}" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Tasks}" 
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#FFF0F0F0"
                              SelectionMode="Single" SelectionChanged="DataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Przypisano do" Binding="{Binding AssignedUser}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Zarządzanie Projektami">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,10,0" AlternatingRowBackground="#FFF0F0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" />
                            <DataGridTextColumn Header="Nazwa Projektu" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Background="#FFF0F0F0" Margin="10,0,0,0">
                        <TextBlock Text="Utwórz nowy projekt" FontSize="16" FontWeight="Bold" Margin="10,10,10,15"/>

                        <TextBlock Text="Nazwa projektu:" Margin="10,0,10,5"/>
                        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,10,10"/>

                        <TextBlock Text="Opis:" Margin="10,0,10,5"/>
                        <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" Margin="10,0,10,15"/>

                        <Button Content="Dodaj projekt" Command="{Binding AddProjectCommand}" Height="35" Background="#0078D7" Foreground="White" FontWeight="Bold" Margin="10,0,10,10"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Mój Profil i Ustawienia">
                <StackPanel Margin="40" Width="350" HorizontalAlignment="Left">
                    <TextBlock Text="Ustawienia Twojego Konta" FontSize="22" FontWeight="Bold" Margin="0,0,0,25" Foreground="#333333"/>

                    <TextBlock Text="Nazwa użytkownika:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#555555"/>
                    <TextBox Text="{Binding CurrentUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="6" FontSize="14"/>

                    <TextBlock Text="Adres e-mail:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#555555"/>
                    <TextBox Text="{Binding CurrentUserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="6" FontSize="14"/>

                    <Separator Margin="0,10,0,20" Background="#DDDDDD" />

                    <TextBlock Text="Zmień hasło:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#555555"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,25" Padding="6" FontSize="14" />

                    <Button Content="Zapisz zmiany profilu" Command="{Binding SaveProfileCommand}" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    
                </StackPanel>
            </TabItem>

        </TabControl>
        
        <Border Background="#323232" 
                CornerRadius="8" 
                Padding="20,10" 
                Margin="20" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifier.IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Notifier.Message}" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       FontSize="14"/>
            
        </Border>

        
        
    </Grid>
</Window>