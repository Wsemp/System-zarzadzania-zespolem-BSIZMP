<Window x:Class="desktopapp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktopapp.Views"
        xmlns:vm="clr-namespace:desktopapp.ViewModels" 
        mc:Ignorable="d"
        Title="Logowanie - Taskomat" Height="500" Width="800" WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBlue}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Wycentrowana biała karta formularza z cieniem -->
        <Border Background="White" Width="350" Padding="30" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" ShadowDepth="4" BlurRadius="10" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo/Tytuł okna w karcie -->
                <TextBlock Text="Witaj w Taskomat" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDarkGray}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Zaloguj się, aby kontynuować" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Formularz Logowania -->
                <TextBlock Text="Nazwa użytkownika" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" Margin="0,0,0,15" />

                <TextBlock Text="Hasło" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="MyPasswordBox" PasswordChanged="MyPasswordBox_PasswordChanged" Margin="0,0,0,25" />

                <!-- Akcje -->
                <Button Content="Zaloguj się" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Height="40" FontSize="16" FontWeight="SemiBold"/>
                
                <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Margin="0,20"/>
                
                <Button Content="Nie masz konta? Zarejestruj się" Command="{Binding OpenRegisterWindowCommand}" Style="{StaticResource SecondaryButton}" BorderThickness="0" Foreground="{StaticResource PrimaryBlue}"/>
                <Button Content="Zapomniałeś hasła?" Command="{Binding OpenForgotPasswordWindowCommand}" 
                        Background="Transparent" BorderThickness="0" Foreground="#0078D7" Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>