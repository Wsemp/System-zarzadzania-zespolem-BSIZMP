<Window x:Class="desktopapp.Views.InviteUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzaj zespołem (Zaproś)" Height="350" Width="400" WindowStartupLocation="CenterScreen" 
        Background="#F5F5F5" ResizeMode="NoResize">
    <Grid>
        <Border Background="White" Margin="20" Padding="20" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="2" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Zaproś do projektu" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Dodaj nowego członka do zespołu" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Adres email użytkownika:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5,0,5,0" VerticalContentAlignment="Center" Margin="0,0,0,15" FontSize="14"/>

                <TextBlock Text="Wiadomość (opcjonalnie):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5,0,5,0" VerticalContentAlignment="Center" Margin="0,0,0,20" FontSize="14"/>

                <Button Content="Wyślij zaproszenie" Command="{Binding SendInviteCommand}" 
                        Background="#28A745" Foreground="White" Height="35" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>